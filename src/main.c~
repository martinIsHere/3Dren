Point3D p3d_at( Point3DArray array, unsigned int index )
{
  if ( index < array.length )
  {
    return array.array[index];
  }
  printf( "Point3D p3d_at( Point3DArray array, unsigned int index )\n" );
  printf( "out of bounds\n" );
  Point3D nullPoint = {0, 0, 0};
  return nullPoint;
}

#define MAX_VERTICES_PER_FACE 3
typedef struct
{
  unsigned int* array;
} Face;

typedef struct
{
  unsigned int length;
  Face* array;
} FaceArray;

typedef struct
{
  Point3DArray vertices; // array of point3D
  FaceArray faces; // array of arrays of 3 uint32
  Color color; // color
} Model;

Point3D model_getVertex(
    Model model,
    unsigned int faceIndex,
    unsigned int vertexIndex 
    )
{
  if ( faceIndex >= model.faces.length )
  {
    printf( " faceIndex >= model.faces.length \n" );
    Point3D nullPoint = {0, 0, 0};
    return nullPoint;
  }
  if ( vertexIndex >= MAX_VERTICES_PER_FACE )
  {
    printf( " vertexIndex >= model.faces.length \n" );
    Point3D nullPoint = {0, 0, 0};
    return nullPoint;
  }
  const unsigned int indexVertices = model.faces.array[faceIndex].array[vertexIndex];

  if ( indexVertices >= model.vertices.length )
  {
    printf( " indexVertices >= model.vertices \n" );
    Point3D nullPoint = {0, 0, 0};
    return nullPoint;
  }
  return model.vertices.array[indexVertices];
}


//-#- functions
void default_clearScreen( const SDL_Renderer* renderer )
{
    /* Clear screen to black */
    SDL_SetRenderDrawColor( renderer, 0, 0, 0, 255 );
    SDL_RenderClear( renderer );
}

GeneralGameData handleSdlEvent( GeneralGameData genData, const SDL_Event* event )
{
  if( event->type == SDL_QUIT )
  {
    genData.gameIsRunning = FALSE;
  }
  return genData;
}

Point2D transform_spaceToScreen( const Point3D pnt )
{
  // projection
  Point2D transformedPoint;
  if ( pnt.z != 0 )
  {
    transformedPoint.x = pnt.x / pnt.z;
    transformedPoint.y = pnt.y / pnt.z;
  } else {
    printf( "pnt.z == 0" );
    transformedPoint.x = -9999;
    transformedPoint.y = -9999;
  }

  // to screen coords
  transformedPoint.x += 1;
  transformedPoint.y += 1;
  transformedPoint.x *= SCREEN_WIDTH * 0.5;
  transformedPoint.y *= SCREEN_HEIGHT * 0.5;
  return transformedPoint;
}

bool pointIsInsideRect( const Rect viewRect, const Point2D pnt )
{

  if ( pnt.x > viewRect.x && pnt.x < viewRect.x + viewRect.width )
  {
    if ( pnt.y > viewRect.y && pnt.y < viewRect.y + viewRect.height )
    {
      return TRUE;
    }
  }
  return FALSE;
}

bool drawPoint2D_screen( const SDL_Renderer* renderer, const Rect viewRect, const Point2D pnt, const Color color )
{
  const int size = 5;
  const int offset = -( size >> 1 );
  SDL_Rect rect = {0, 0, size, size};
  if ( pointIsInsideRect(viewRect, pnt) )
  {
    rect.x = pnt.x + offset;
    rect.y = pnt.y + offset;

    SDL_SetRenderDrawColor( renderer, color.r, color.g, color.b, 255);
    // SDL_SetRenderDrawColor( renderer, 255, 0, 0, 255 );
    SDL_RenderFillRect( renderer, &rect );
    // printf( "x: %d\n", rect.x );
    // printf( "y: %d\n", rect.y );
    // printf( "w: %d\n", rect.w );
    // printf( "h: %d\n", rect.h );
    return TRUE;
  }
  return FALSE;
}

bool drawLine2D_screen( 
    const SDL_Renderer* renderer, 
    const Rect viewRect, 
    const Point2D pnt1, 
    const Point2D pnt2, 
    const Color color 
    )
{
  bool pnt1_isVisible =  pointIsInsideRect( viewRect, pnt1 ) ;
  bool pnt2_isVisible =  pointIsInsideRect( viewRect, pnt2 ) ;
  if ( pnt1_isVisible || pnt2_isVisible)
  {
    SDL_SetRenderDrawColor( renderer, color.r, color.g, color.b, 255);
    // SDL_SetRenderDrawColor( renderer, 255, 0, 0, 255 );
    SDL_RenderDrawLine( renderer, pnt1.x, pnt1.y, pnt2.x, pnt2.y);
    return TRUE;
  }
  return FALSE;
}

bool drawFace_screen( 
    const SDL_Renderer* renderer, 
    const Rect viewRect, 
    const Model model,
    const unsigned faceIndex
    )
{
  for ( int vertexIndex = 0; vertexIndex < MAX_VERTICES_PER_FACE; vertexIndex++ ) 
  {
    Point2D projected_3DPoint = transform_spaceToScreen(model_getVertex(
        model,
        faceIndex,
        vertexIndex
        ));
    drawPoint2D_screen( renderer, viewRect, projected_3DPoint, model.color );
  }
  Point2D projected_3DPoint1 = transform_spaceToScreen(model_getVertex(
      model,
      faceIndex,
      0
      ));
  Point2D projected_3DPoint2 = transform_spaceToScreen(model_getVertex(
      model,
      faceIndex,
      1
      ));
  Point2D projected_3DPoint3 = transform_spaceToScreen(model_getVertex(
      model,
      faceIndex,
      2
      ));
  drawLine2D_screen( renderer, viewRect, projected_3DPoint1, projected_3DPoint2, model.color );
  drawLine2D_screen( renderer, viewRect, projected_3DPoint2, projected_3DPoint3, model.color );
  drawLine2D_screen( renderer, viewRect, projected_3DPoint3, projected_3DPoint1, model.color );
  return TRUE;
}



